# ===========================================
# Database Configuration
# ===========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DATABASE=your_db_name

# ===========================================
# Application Configuration
# ===========================================
PORT=3002
MODE=DEV

# ===========================================
# JWT Authentication
# ===========================================
# Secret key for signing JWT tokens (use a strong random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
# Token expiration time (e.g., 1d, 12h, 30m)
JWT_EXPIRES_IN=1d

# ===========================================
# Admin User (for basic auth demo)
# ===========================================
# Default admin username
ADMIN_USERNAME=admin
# Password hash generated with bcrypt (default: "admin123")
# Generate new hash: node -e "require('bcrypt').hash('your-password', 10).then(console.log)"
ADMIN_PASSWORD_HASH=$2b$10$Wqc9W66wj5i0Tn7E5V4bUexp.XSSCtwwUqYEqasbyZ2HYR6Wt13eW

# ===========================================
# CORS Configuration
# ===========================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ===========================================
# Rate Limiting
# ===========================================
# Time window in milliseconds
RATE_LIMIT_TTL=60000
# Maximum requests per time window
RATE_LIMIT_MAX=100
