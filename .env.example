# ===========================================
# Docker Environment Variables
# Copy this file to .env and fill in the values
# ===========================================

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=employees

# Application Mode
MODE=PROD

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1d

# Admin User
ADMIN_USERNAME=admin
# Generate hash with: cd apps/api && npx ts-node src/scripts/generate-password-hash.ts <password>
ADMIN_PASSWORD_HASH=$2b$10$rQZQZQZQZQZQZQZQZQZQZuYourHashHere

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Rate Limiting
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100

# Frontend API URL (used during build)
NEXT_PUBLIC_API_URL=http://localhost:3002
